PORT=5000
NODE_ENV=development

# Copy this file to .env and fill in your values.
# MySQL database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=winterstore

# JWT authentication
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secure_secret_here
JWT_EXPIRES_IN=7d

# Initial admin account (used by npm run seed:admin - set a real password locally in .env)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=