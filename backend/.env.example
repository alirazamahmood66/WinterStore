PORT=5000
NODE_ENV=development

# Copy this file to .env and fill in your values.
# MySQL database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=winterstore

# DB_SSL_CA — Aiven/managed MySQL CA certificate for TLS verification.
# Paste the EXACT full Ca.pem contents from the Aiven service (multi-line,
# including the "-----BEGIN CERTIFICATE-----" / "-----END ..." lines).
# When set, mysql2 verifies the server against this CA; rejectUnauthorized is
# never disabled. A base64-encoded value is also accepted. Leave empty for local MySQL.
DB_SSL_CA=

# JWT authentication
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secure_secret_here
JWT_EXPIRES_IN=7d

# Initial admin account (used by npm run seed:admin - set a real password locally in .env)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=